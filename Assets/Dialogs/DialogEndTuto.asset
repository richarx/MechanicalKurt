  m_Script: {fileID: 11500000, guid: 1b0317d929739a34e839d08c8427854a, type: 3}
  m_Name: DialogEndTuto
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  speaker: MASTER
  lines:
  - text: 'Kurt! The city needs you! '
  - text: Ever since we gave up some of our techs to rely on pigeon, I trained you.
  - text: Now you can help people.
  - text: Or do whatever you want, like flying throught a donut, I don't know...
  - text: The city is yours!
  - text: FLY YOU MAGNIFICENT BASTARD!
