  m_Name: SpidermanEnd
  m_EditorClassIdentifier: Assembly-CSharp::DialogSequence
  speaker: Arthropod-Man
  lines:
  - text: 'Oh, thank you! You just saved my career. '
  - text: Me? I thought I spotted a supervillain. Well, turned out it was a monkey statue.
  - text: In my defense, very suspicious posture.
  - text: Hey before leaving.
  - text: Could you spot me five bucks? Times are rough.
  - text: No? Ok...
